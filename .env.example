# ==============================================================================
# 🩺 TG KINDSYNC PRO V14.5 — FULL CONFIGURATION SPECIFICATION (.env)
# Enterprise Telegram Cloud Forwarder & Real-Time Sync Engine
# Developer & Owner: Dr. Amit Singh (Kind Doctor)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TELEGRAM API CREDENTIALS (Mandatory 1-Time Setup)
# ------------------------------------------------------------------------------
# Free me lene ka tarika:
# 1. Open https://my.telegram.org in your browser.
# 2. Apne mobile number se login karein aur Telegram par aaya code dalein.
# 3. 'API development tools' par click karein aur koi bhi app name dalein.
# 4. Wahan se API_ID aur API_HASH copy karke yahan paste karein:
API_ID=YOUR_API_ID_HERE
API_HASH=YOUR_API_HASH_HERE

# ------------------------------------------------------------------------------
# 2. BASIC ROUTING CONFIGURATION (Single Source ➔ Target Route)
# ------------------------------------------------------------------------------
# SOURCE_CHAT: Jahan se messages copy / forward karne hain.
# TARGET_CHAT: Jahan messages send / replicate karne hain.
# Supported Formats:
#   • Channel Link  : https://t.me/c/1234567890/1
#   • Public User   : @your_channel_name
#   • Numeric ID    : -1001234567890 (Supergroup/Channel ID)
SOURCE_CHAT=0
TARGET_CHAT=0

# Topics / Forums (Agar channel ya supergroup me Forum Topics enable hain)
# 0 = General Topic / Main Chat (Default)
SOURCE_TOPIC=0
TARGET_TOPIC=0

# ------------------------------------------------------------------------------
# 3. ADVANCED MULTI-ROUTING RULES (Multiple Channels / Topics Forwarding)
# ------------------------------------------------------------------------------
# Format: source_chat:source_topic:target_chat:target_topic, ...
# Example: -1001111:0:-1002222:0, -1001111:15:-1003333:45
FORWARDING_RULES=

# Multi-Mirror Target Broadcasts (Ek source se multiple channels me bhejna)
# Comma-separated list of target chat IDs:
MIRROR_TARGETS=

# ------------------------------------------------------------------------------
# 4. FORWARDING MODES & BEHAVIOR
# ------------------------------------------------------------------------------
# DIRECT_FORWARD:
#   • true  : Official native Telegram forward (Preserves original sender & fast)
#   • false : Clean replicate (Re-uploads with custom watermark & formatting)
DIRECT_FORWARD=false

# LIVE_MODE:
#   • true  : Real-time live listener (Forwards new messages instantly as they arrive)
#   • false : Interactive historical batch forwarder (Allows date/ID range selection)
LIVE_MODE=false

# ------------------------------------------------------------------------------
# 5. STUDY & MEDIA FORMATTING ENHANCEMENTS
# ------------------------------------------------------------------------------
# GENERATE_BATCH_INDEX: Batch complete hone par ek clean Markdown summary card post karega.
GENERATE_BATCH_INDEX=true

# AUTO_HASHTAGS: Messages me auto-detect study hashtags lagana (#Cardiology, #Physiology, etc.)
AUTO_HASHTAGS=false

# AUTO_SUBJECT_HEADERS: Subject roadmaps aur headers auto-inject karna
AUTO_SUBJECT_HEADERS=true

# AUTO_SORT_SUBJECTS: Subjects ko alphabetic ya syllabus order me organize karna
AUTO_SORT_SUBJECTS=true

# CLEAN_PROMO_LINKS: Source message se faltu external promo links aur spam clean karna
CLEAN_PROMO_LINKS=true

# MEDIA_FILTER: Kounse messages forward karne hain:
# Values: all (sabkuch), video (sirf videos), document (sirf PDFs/files), photo (sirf photos)
MEDIA_FILTER=all

# FILTER_KEYWORDS: Sirf in keywords wale messages forward honge (comma-separated, optional)
FILTER_KEYWORDS=

# FILTER_EXCLUDE: In keywords wale messages skip ho jayenge (comma-separated, optional)
FILTER_EXCLUDE=

# ------------------------------------------------------------------------------
# 6. PERFORMANCE & RUNTIME CONTROLS
# ------------------------------------------------------------------------------
# WORKERS: Number of concurrent workers (Default: 12)
WORKERS=12

# PARALLELISM: Upload pipelines parallelism (Default: 12)
UPLOAD_PARALLELISM=12

# AUTO_SHUTDOWN: Batch complete hone par computer shutdown karna (true / false)
AUTO_SHUTDOWN=false

# BATCH_NAME: Custom label for this batch run (optional)
BATCH_NAME=
